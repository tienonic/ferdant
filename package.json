{
  "name": "ferdant-site",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "python scripts/build.py",
    "check:content": "python scripts/check-content.py",
    "test:commerce": "node --test tests/shopify.test.mjs",
    "verify:responsive": "node tests/site-check.cjs",
    "verify:maps": "node tests/resource-map.cjs",
    "verify:disasters": "node tests/disaster-plans.cjs && node tests/layer-loading.cjs",
    "verify:services": "python -m unittest discover -s tests -p test_physical_services.py && node tests/physical-services.cjs",
    "verify:statewide": "node tests/statewide-services.cjs",
    "verify:everyday": "node tests/everyday-services.cjs && node tests/everyday-visibility.cjs",
    "verify:booklet": "node tests/resource-booklet.cjs",
    "verify:risk": "node tests/hazard-risk.cjs",
    "verify:recommendations": "node tests/recommendations.cjs",
    "verify:scopes": "node tests/resource-scopes.cjs && node tests/county-preview.cjs && node tests/state-view.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
